diff --git a/App/imu/mpu6050.c b/App/imu/mpu6050.c
new file mode 100644
index 0000000..e741bc6
--- /dev/null
+++ b/App/imu/mpu6050.c
@@ -0,0 +1,69 @@
+#include "imu/mpu6050.h"
+
+/* Register map (MPU-6000/6050 register map, rev 4.2) */
+#define REG_SMPLRT_DIV     0x19u
+#define REG_CONFIG         0x1Au
+#define REG_INT_ENABLE     0x38u
+#define REG_ACCEL_XOUT_H   0x3Bu   /* start of the 14-byte burst */
+#define REG_PWR_MGMT_1     0x6Bu
+#define REG_WHO_AM_I       0x75u
+
+#define WHO_AM_I_VALUE     0x68u
+
+#define PWR_DEVICE_RESET   0x80u
+#define PWR_CLKSEL_XGYRO   0x01u   /* SLEEP cleared, clock = X-axis gyro PLL */
+#define CFG_DLPF_CFG_3     0x03u
+#define SMPLRT_DIV_100HZ   9u      /* 1 kHz / (1 + 9) = 100 Hz */
+#define INT_DATA_RDY_EN    0x01u
+
+#define TIMEOUT_CFG_MS     100u
+#define TIMEOUT_BURST_MS   20u
+#define DELAY_AFTER_RESET_MS   100u
+#define DELAY_AFTER_WAKE_MS    10u
+
+static uint16_t dev_addr(const mpu6050_t *dev)
+{
+    return (uint16_t)(dev->addr7 << 1);
+}
+
+static bool write_reg(const mpu6050_t *dev, uint8_t reg, uint8_t val)
+{
+    return HAL_I2C_Mem_Write(dev->hi2c, dev_addr(dev), reg, I2C_MEMADD_SIZE_8BIT,
+                             &val, 1, TIMEOUT_CFG_MS) == HAL_OK;
+}
+
+mpu6050_status_t mpu6050_init(mpu6050_t *dev, I2C_HandleTypeDef *hi2c, uint8_t addr7)
+{
+    dev->hi2c  = hi2c;
+    dev->addr7 = addr7;
+
+    uint8_t id = 0;
+    if (HAL_I2C_Mem_Read(dev->hi2c, dev_addr(dev), REG_WHO_AM_I, I2C_MEMADD_SIZE_8BIT,
+                         &id, 1, TIMEOUT_CFG_MS) != HAL_OK)
+        return MPU6050_ERR_BUS;
+    if (id != WHO_AM_I_VALUE)
+        return MPU6050_ERR_ID;
+
+    if (!write_reg(dev, REG_PWR_MGMT_1, PWR_DEVICE_RESET))
+        return MPU6050_ERR_BUS;
+    HAL_Delay(DELAY_AFTER_RESET_MS);
+
+    if (!write_reg(dev, REG_PWR_MGMT_1, PWR_CLKSEL_XGYRO))
+        return MPU6050_ERR_BUS;
+    HAL_Delay(DELAY_AFTER_WAKE_MS);
+
+    if (!write_reg(dev, REG_CONFIG, CFG_DLPF_CFG_3))
+        return MPU6050_ERR_BUS;
+    if (!write_reg(dev, REG_SMPLRT_DIV, SMPLRT_DIV_100HZ))
+        return MPU6050_ERR_BUS;
+    if (!write_reg(dev, REG_INT_ENABLE, INT_DATA_RDY_EN))   /* last: interrupts start here */
+        return MPU6050_ERR_BUS;
+
+    return MPU6050_OK;
+}
+
+bool mpu6050_read_raw(const mpu6050_t *dev, uint8_t raw[MPU6050_RAW_LEN])
+{
+    return HAL_I2C_Mem_Read(dev->hi2c, dev_addr(dev), REG_ACCEL_XOUT_H, I2C_MEMADD_SIZE_8BIT,
+                            raw, MPU6050_RAW_LEN, TIMEOUT_BURST_MS) == HAL_OK;
+}
diff --git a/App/imu/mpu6050.h b/App/imu/mpu6050.h
new file mode 100644
index 0000000..2b1f517
--- /dev/null
+++ b/App/imu/mpu6050.h
@@ -0,0 +1,46 @@
+#ifndef APP_IMU_MPU6050_H
+#define APP_IMU_MPU6050_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "stm32h7xx_hal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define MPU6050_ADDR_AD0_LOW   0x68u   /* 7-bit address, AD0 pin low */
+#define MPU6050_RAW_LEN        14u     /* ax ay az temp gx gy gz, 2 bytes each */
+
+typedef struct {
+    I2C_HandleTypeDef *hi2c;
+    uint8_t            addr7;          /* 7-bit I2C address */
+} mpu6050_t;
+
+typedef enum {
+    MPU6050_OK = 0,
+    MPU6050_ERR_BUS,                   /* an I2C transaction failed */
+    MPU6050_ERR_ID,                    /* WHO_AM_I did not read 0x68 */
+} mpu6050_status_t;
+
+/**
+ * Probe WHO_AM_I, reset the device and configure it for 100 Hz output
+ * (DLPF_CFG=3, SMPLRT_DIV=9) with the DATA_RDY interrupt enabled.
+ *
+ * Blocking: takes about 110 ms because of the post-reset delays.
+ * Returns on the first failing step; later steps are not attempted.
+ */
+mpu6050_status_t mpu6050_init(mpu6050_t *dev, I2C_HandleTypeDef *hi2c, uint8_t addr7);
+
+/**
+ * Burst-read regs 0x3B..0x48 into raw[] with no conversion.
+ * Returns true on success.  Blocking, 20 ms timeout.
+ */
+bool mpu6050_read_raw(const mpu6050_t *dev, uint8_t raw[MPU6050_RAW_LEN]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* APP_IMU_MPU6050_H */
diff --git a/App/packet/crc16.c b/App/packet/crc16.c
new file mode 100644
index 0000000..7a06b7b
--- /dev/null
+++ b/App/packet/crc16.c
@@ -0,0 +1,12 @@
+#include "packet/crc16.h"
+
+uint16_t crc16_ccitt(const uint8_t *data, size_t len)
+{
+    uint16_t crc = 0xFFFF;
+    while (len--) {
+        crc ^= (uint16_t)(*data++) << 8;
+        for (int i = 0; i < 8; i++)
+            crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
+    }
+    return crc;
+}
diff --git a/App/packet/crc16.h b/App/packet/crc16.h
new file mode 100644
index 0000000..d62e8b1
--- /dev/null
+++ b/App/packet/crc16.h
@@ -0,0 +1,23 @@
+#ifndef APP_PACKET_CRC16_H
+#define APP_PACKET_CRC16_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * CRC-16/CCITT-FALSE: poly 0x1021, init 0xFFFF, MSB first, no reflection,
+ * no final XOR.  Check value: crc16_ccitt("123456789", 9) == 0x29B1.
+ *
+ * Pure function with no hardware dependency, so it builds on the host.
+ */
+uint16_t crc16_ccitt(const uint8_t *data, size_t len);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* APP_PACKET_CRC16_H */
diff --git a/App/packet/imu_packet.c b/App/packet/imu_packet.c
new file mode 100644
index 0000000..d665ddf
--- /dev/null
+++ b/App/packet/imu_packet.c
@@ -0,0 +1,31 @@
+#include "packet/imu_packet.h"
+#include "packet/crc16.h"
+
+_Static_assert(IMU_PKT_OFF_SEQ == 2u && IMU_PKT_OFF_TS == IMU_PKT_OFF_SEQ + 2u,
+               "seq is 2 bytes at offset 2, ts follows");
+_Static_assert(IMU_PKT_OFF_RAW == IMU_PKT_OFF_TS + 4u, "raw follows the 4-byte ts");
+_Static_assert(IMU_PKT_OFF_CRC == IMU_PKT_OFF_RAW + IMU_PKT_RAW_LEN, "crc follows raw");
+_Static_assert(IMU_PKT_OFF_CRC + 2u == IMU_PKT_LEN, "crc is the last 2 bytes");
+_Static_assert(IMU_PKT_CRC_SPAN == IMU_PKT_OFF_CRC - IMU_PKT_OFF_SEQ, "crc covers seq..raw");
+
+void imu_packet_encode(uint8_t out[IMU_PKT_LEN], uint16_t seq, uint32_t ts_us,
+                       const uint8_t raw[IMU_PKT_RAW_LEN])
+{
+    out[0] = IMU_PKT_SYNC0;
+    out[1] = IMU_PKT_SYNC1;
+
+    out[IMU_PKT_OFF_SEQ + 0] = (uint8_t)(seq);
+    out[IMU_PKT_OFF_SEQ + 1] = (uint8_t)(seq >> 8);
+
+    out[IMU_PKT_OFF_TS + 0] = (uint8_t)(ts_us);
+    out[IMU_PKT_OFF_TS + 1] = (uint8_t)(ts_us >> 8);
+    out[IMU_PKT_OFF_TS + 2] = (uint8_t)(ts_us >> 16);
+    out[IMU_PKT_OFF_TS + 3] = (uint8_t)(ts_us >> 24);
+
+    for (unsigned i = 0; i < IMU_PKT_RAW_LEN; i++)
+        out[IMU_PKT_OFF_RAW + i] = raw[i];
+
+    uint16_t crc = crc16_ccitt(&out[IMU_PKT_OFF_SEQ], IMU_PKT_CRC_SPAN);
+    out[IMU_PKT_OFF_CRC + 0] = (uint8_t)(crc);
+    out[IMU_PKT_OFF_CRC + 1] = (uint8_t)(crc >> 8);
+}
diff --git a/App/packet/imu_packet.h b/App/packet/imu_packet.h
new file mode 100644
index 0000000..e381332
--- /dev/null
+++ b/App/packet/imu_packet.h
@@ -0,0 +1,50 @@
+#ifndef APP_PACKET_IMU_PACKET_H
+#define APP_PACKET_IMU_PACKET_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * IMU sample packet, 24 bytes, sent over USART1.  All multi-byte header
+ * fields are little-endian.  See docs/packet_protocol.md.
+ *
+ *   offset  size  field
+ *   0       2     sync     0xAA 0x55
+ *   2       2     seq      uint16, +1 per packet, wraps at 65536
+ *   4       4     ts_us    uint32, TIM2 count (1 us) at the DATA_RDY edge
+ *   8       14    raw      MPU-6050 regs 0x3B..0x48 verbatim (big-endian):
+ *                          ax ay az temp gx gy gz, int16 each
+ *   22      2     crc16    CRC-16/CCITT-FALSE over bytes 2..21
+ */
+#define IMU_PKT_SYNC0         0xAAu
+#define IMU_PKT_SYNC1         0x55u
+
+#define IMU_PKT_RAW_LEN       14u
+#define IMU_PKT_LEN           24u
+
+#define IMU_PKT_OFF_SYNC      0u
+#define IMU_PKT_OFF_SEQ       2u
+#define IMU_PKT_OFF_TS        4u
+#define IMU_PKT_OFF_RAW       8u
+#define IMU_PKT_OFF_CRC       22u
+#define IMU_PKT_CRC_SPAN      20u   /* bytes 2..21 */
+
+/**
+ * Build one packet.  Pure function, no hardware dependency.
+ *
+ * @param out    receives IMU_PKT_LEN bytes
+ * @param seq    sequence number
+ * @param ts_us  timestamp in microseconds
+ * @param raw    IMU_PKT_RAW_LEN bytes, copied verbatim
+ */
+void imu_packet_encode(uint8_t out[IMU_PKT_LEN], uint16_t seq, uint32_t ts_us,
+                       const uint8_t raw[IMU_PKT_RAW_LEN]);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* APP_PACKET_IMU_PACKET_H */
diff --git a/App/sampling/drdy_queue.c b/App/sampling/drdy_queue.c
new file mode 100644
index 0000000..c26d172
--- /dev/null
+++ b/App/sampling/drdy_queue.c
@@ -0,0 +1,43 @@
+#include "sampling/drdy_queue.h"
+
+_Static_assert((DRDY_QUEUE_SIZE & (DRDY_QUEUE_SIZE - 1u)) == 0u,
+               "DRDY_QUEUE_SIZE must be a power of two");
+
+#define MASK (DRDY_QUEUE_SIZE - 1u)
+
+void drdy_queue_init(drdy_queue_t *q)
+{
+    for (uint32_t i = 0; i < DRDY_QUEUE_SIZE; i++)
+        q->ts_us[i] = 0;
+    q->head    = 0;
+    q->tail    = 0;
+    q->dropped = 0;
+}
+
+bool drdy_queue_push_from_isr(drdy_queue_t *q, uint32_t ts_us)
+{
+    uint32_t head = q->head;
+    uint32_t next = (head + 1u) & MASK;
+    if (next == q->tail) {            /* full */
+        q->dropped++;
+        return false;
+    }
+    q->ts_us[head] = ts_us;           /* publish the slot before moving head */
+    q->head = next;
+    return true;
+}
+
+bool drdy_queue_pop(drdy_queue_t *q, uint32_t *ts_us)
+{
+    uint32_t tail = q->tail;
+    if (tail == q->head)              /* empty */
+        return false;
+    *ts_us = q->ts_us[tail];
+    q->tail = (tail + 1u) & MASK;
+    return true;
+}
+
+uint32_t drdy_queue_dropped(const drdy_queue_t *q)
+{
+    return q->dropped;
+}
diff --git a/App/sampling/drdy_queue.h b/App/sampling/drdy_queue.h
new file mode 100644
index 0000000..2e3e24c
--- /dev/null
+++ b/App/sampling/drdy_queue.h
@@ -0,0 +1,46 @@
+#ifndef APP_SAMPLING_DRDY_QUEUE_H
+#define APP_SAMPLING_DRDY_QUEUE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Must be a power of two.  Usable capacity is DRDY_QUEUE_SIZE - 1. */
+#define DRDY_QUEUE_SIZE 16u
+
+/*
+ * Single-producer / single-consumer queue of DATA_RDY timestamps.
+ *
+ *   producer: the EXTI ISR           -> drdy_queue_push_from_isr()
+ *   consumer: the main loop          -> drdy_queue_pop()
+ *
+ * Lock-free: only the producer writes `head` and the slots, only the
+ * consumer writes `tail`.  This is correct for ONE producer and ONE consumer
+ * on a single core, which is how it is used here.  Do not call push from two
+ * different interrupt priorities, and do not call pop from an ISR.
+ */
+typedef struct {
+    volatile uint32_t ts_us[DRDY_QUEUE_SIZE];
+    volatile uint32_t head;      /* written by the ISR   */
+    volatile uint32_t tail;      /* written by main loop */
+    volatile uint32_t dropped;   /* pushes rejected because the queue was full */
+} drdy_queue_t;
+
+void drdy_queue_init(drdy_queue_t *q);
+
+/** Returns false (and counts a drop) when full. */
+bool drdy_queue_push_from_isr(drdy_queue_t *q, uint32_t ts_us);
+
+/** Returns false when empty. */
+bool drdy_queue_pop(drdy_queue_t *q, uint32_t *ts_us);
+
+uint32_t drdy_queue_dropped(const drdy_queue_t *q);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* APP_SAMPLING_DRDY_QUEUE_H */
