+#ifndef STM32H7XX_HAL_STUB_H
+#define STM32H7XX_HAL_STUB_H
+
+/*
+ * Host-side stand-in for the handful of HAL symbols that App/ and the
+ * main.c glue use.  Signatures match the real STM32H7 HAL.  Never used in
+ * the firmware build: there the real header comes from Drivers/.
+ */
+#include <stdint.h>
+
+typedef enum { HAL_OK = 0, HAL_ERROR = 1, HAL_BUSY = 2, HAL_TIMEOUT = 3 } HAL_StatusTypeDef;
+
+typedef struct { int unused; }       I2C_HandleTypeDef;
+typedef struct { int unused; }       UART_HandleTypeDef;
+typedef struct { uint32_t counter; } TIM_HandleTypeDef;
+
+#define I2C_MEMADD_SIZE_8BIT  0x00000001U
+#define GPIO_PIN_3            ((uint16_t)0x0008)
+#define __HAL_TIM_GET_COUNTER(__HANDLE__) ((__HANDLE__)->counter)
+
+HAL_StatusTypeDef HAL_I2C_Mem_Read(I2C_HandleTypeDef *hi2c, uint16_t DevAddress,
+                                   uint16_t MemAddress, uint16_t MemAddSize,
+                                   uint8_t *pData, uint16_t Size, uint32_t Timeout);
+HAL_StatusTypeDef HAL_I2C_Mem_Write(I2C_HandleTypeDef *hi2c, uint16_t DevAddress,
+                                    uint16_t MemAddress, uint16_t MemAddSize,
+                                    uint8_t *pData, uint16_t Size, uint32_t Timeout);
+HAL_StatusTypeDef HAL_UART_Transmit(UART_HandleTypeDef *huart, const uint8_t *pData,
+                                    uint16_t Size, uint32_t Timeout);
+HAL_StatusTypeDef HAL_TIM_Base_Start(TIM_HandleTypeDef *htim);
+void HAL_Delay(uint32_t Delay);
+
+#endif /* STM32H7XX_HAL_STUB_H */
diff --git a/tests/host/run_glue.py b/tests/host/run_glue.py
new file mode 100644
index 0000000..b5b40cc
--- /dev/null
+++ b/tests/host/run_glue.py
@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""A/B test of the main.c glue: pre-refactor vs post-refactor.
+
+Both versions are compiled for the host (see gen_glue.py / Makefile) and run
+against the same simulated MPU-6050.  Compared per scenario:
+  * exit code
+  * the UART bytes (must be identical)
+  * the trace of every I2C / UART / delay call (identical apart from where
+    HAL_TIM_Base_Start sits, which moved earlier on purpose)
+The post-refactor UART bytes are then fed to the real, unmodified
+tools/parse_imu.py through a fake serial port.
+"""
+import os
+import pathlib
+import re
+import subprocess
+import sys
+
+HERE = pathlib.Path(__file__).resolve().parent
+ROOT = HERE.parents[1]
+B = HERE / "build"
+PARSER = ROOT / "tools" / "parse_imu.py"
+failures = []
+
+
+def check(cond, msg):
+    print(("  ok    " if cond else "  FAIL  ") + msg)
+    if not cond:
+        failures.append(msg)
+
+
+def run(binname, scen):
+    uart, trace = B / f"{binname}.{scen}.uart", B / f"{binname}.{scen}.trace"
+    for p in (uart, trace):
+        p.unlink(missing_ok=True)
+    env = dict(os.environ, SIM_SCENARIO=scen, SIM_UART=str(uart), SIM_TRACE=str(trace),
+               ASAN_OPTIONS="detect_leaks=0")
+    rc = subprocess.run([str(B / binname)], env=env).returncode
+    return rc, uart, (uart.read_bytes() if uart.exists() else b""), \
+        (trace.read_text().splitlines() if trace.exists() else [])
+
+
+def parse(uart):
+    env = dict(os.environ, PYTHONPATH=str(HERE / "fake_serial"))
+    out = subprocess.run([sys.executable, str(PARSER), str(uart), "0.5"], env=env,
+                         capture_output=True, text=True, check=True).stdout
+    m = re.search(r"ok=(\d+)\s+crc_bad=(\d+)\s+seq_gaps=(\d+)\s+lost=(\d+)\s+resync_bytes=(\d+)", out)
+    assert m, out
+    r = dict(zip(("ok", "crc_bad", "gaps", "lost", "resync"), map(int, m.groups())))
+    d = re.search(r"dt\(us\): min=(\d+) max=(\d+)", out)
+    r["dt_min"], r["dt_max"] = (int(d.group(1)), int(d.group(2))) if d else (None, None)
+    return r
+
+
+def strip_tim(t):
+    return [l for l in t if l != "TIM_START"]
+
+
+SCENARIOS = {
+    # name:      expected exit code, expected parse_imu.py results on the NEW stream
+    "steady":   (0,  dict(ok=300, crc_bad=0, gaps=0, lost=0, resync=0)),
+    "burst":    (0,  dict(ok=295, crc_bad=0, gaps=0, lost=0, resync=0)),   # 20 IRQs at once -> 5 dropped
+    "readfail": (0,  dict(ok=298, crc_bad=0, gaps=0, lost=0, resync=0)),   # 2 failed I2C bursts
+    "badid":    (42, dict(ok=0,   crc_bad=0, gaps=0, lost=0, resync=0)),
+}
+
+for scen, (exp_rc, exp) in SCENARIOS.items():
+    print(f"== {scen}")
+    orc, _, obytes, otrace = run("glue_old", scen)
+    nrc, nuart, nbytes, ntrace = run("glue_new", scen)
+
+    check(orc == exp_rc and nrc == exp_rc, f"exit code old={orc} new={nrc} (expected {exp_rc})")
+    check(obytes == nbytes, f"UART bytes identical (old {len(obytes)} B, new {len(nbytes)} B)")
+    check(strip_tim(otrace) == strip_tim(ntrace),
+          f"HAL call trace identical apart from TIM_START ({len(otrace)} vs {len(ntrace)} lines)")
+    if any("reg=0x38" in l for l in ntrace):
+        for name, t in (("old", otrace), ("new", ntrace)):
+            int_en = next(i for i, l in enumerate(t) if "reg=0x38" in l)
+            check(t.index("TIM_START") < int_en, f"{name}: timer started before DATA_RDY is enabled")
+
+    r = parse(nuart)
+    check(all(r[k] == v for k, v in exp.items()), f"parse_imu.py on new stream: { {k: r[k] for k in exp} }")
+    if scen == "steady":
+        check(10000 <= r["dt_min"] and r["dt_max"] <= 10003, f"dt(us) {r['dt_min']}..{r['dt_max']} (sim: 10000+0..3)")
+    if scen == "burst":
+        check(r["dt_max"] >= 60000, f"5 dropped events show up as a {r['dt_max']} us timestamp gap, NOT as a seq gap")
+    if scen == "readfail":
+        check(r["dt_max"] >= 30000, f"2 failed reads show up as a {r['dt_max']} us timestamp gap, NOT as a seq gap")
+
+print("== writefail  (intended difference: the new driver checks register writes)")
+orc, _, ob, _ = run("glue_old", "writefail")
+nrc, _, nb, _ = run("glue_new", "writefail")
+check(orc == 0 and len(ob) == 300 * 24, f"old: failed CONFIG write ignored, keeps streaming (exit {orc}, {len(ob)} B)")
+check(nrc == 42 and len(nb) == 0, f"new: failed CONFIG write halts in Error_Handler (exit {nrc}, {len(nb)} B)")
+
+print()
+if failures:
+    print(f"{len(failures)} FAILED")
+    sys.exit(1)
+print("all glue checks passed")
diff --git a/tests/host/test_units.c b/tests/host/test_units.c
new file mode 100644
index 0000000..5c21377
--- /dev/null
+++ b/tests/host/test_units.c
@@ -0,0 +1,251 @@
+/*
+ * Unit tests for App/ (host build, ASan + UBSan).
+ *
+ * The ref_* functions are copied verbatim from the pre-refactor main.c and
+ * serve as the oracle: the new modules must match them byte for byte.
+ */
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "imu/mpu6050.h"
+#include "packet/crc16.h"
+#include "packet/imu_packet.h"
+#include "sampling/drdy_queue.h"
+#include "mock_hal.h"
+
+static int g_checks, g_fail;
+#define CHECK(cond) do { g_checks++; if (!(cond)) { g_fail++; \
+    printf("  FAIL %s:%d  %s\n", __FILE__, __LINE__, #cond); } } while (0)
+
+static uint32_t rs = 0x12345678u;                       /* xorshift32, deterministic */
+static uint32_t rnd(void) { rs ^= rs << 13; rs ^= rs >> 17; rs ^= rs << 5; return rs; }
+
+/* ---- oracle 1: verbatim from the pre-refactor main.c ------------------------- */
+static uint16_t ref_crc16_ccitt(const uint8_t *d, size_t n)
+{
+    uint16_t crc = 0xFFFF;
+    while (n--) {
+        crc ^= (uint16_t)(*d++) << 8;
+        for (int i = 0; i < 8; i++)
+            crc = (crc & 0x8000) ? (uint16_t)((crc << 1) ^ 0x1021) : (uint16_t)(crc << 1);
+    }
+    return crc;
+}
+
+static void ref_encode(uint8_t pkt[24], uint16_t seq, uint32_t ts, const uint8_t b[14])
+{
+    pkt[0]  = 0xAA;
+    pkt[1]  = 0x55;
+    pkt[2]  = (uint8_t)(seq);        pkt[3]  = (uint8_t)(seq >> 8);
+    pkt[4]  = (uint8_t)(ts);         pkt[5]  = (uint8_t)(ts >> 8);
+    pkt[6]  = (uint8_t)(ts >> 16);   pkt[7]  = (uint8_t)(ts >> 24);
+    for (int i = 0; i < 14; i++) pkt[8 + i] = b[i];
+    uint16_t crc = ref_crc16_ccitt(&pkt[2], 20);
+    pkt[22] = (uint8_t)(crc);        pkt[23] = (uint8_t)(crc >> 8);
+}
+
+/* ---- oracle 2: the pre-refactor ISR/main-loop ring, verbatim logic ------------ */
+static volatile uint32_t ref_ring[16], ref_head, ref_tail, ref_dropped;
+static void ref_isr(uint32_t ts)
+{
+    uint32_t next = (ref_head + 1u) & (16u - 1u);
+    if (next == ref_tail) { ref_dropped++; return; }
+    ref_ring[ref_head] = ts;
+    ref_head = next;
+}
+static bool ref_pop(uint32_t *ts)
+{
+    if (ref_tail != ref_head) {
+        *ts = ref_ring[ref_tail];
+        ref_tail = (ref_tail + 1u) & (16u - 1u);
+        return true;
+    }
+    return false;
+}
+
+/* ---- oracle 3: independent table-driven CRC-16/CCITT-FALSE -------------------- */
+static uint16_t tbl[256];
+static void tbl_init(void)
+{
+    for (int i = 0; i < 256; i++) {
+        uint16_t c = (uint16_t)(i << 8);
+        for (int k = 0; k < 8; k++) c = (c & 0x8000) ? (uint16_t)((c << 1) ^ 0x1021) : (uint16_t)(c << 1);
+        tbl[i] = c;
+    }
+}
+static uint16_t crc_tbl(const uint8_t *d, size_t n)
+{
+    uint16_t c = 0xFFFF;
+    while (n--) c = (uint16_t)((c << 8) ^ tbl[(uint8_t)((c >> 8) ^ *d++)]);
+    return c;
+}
+
+/* ------------------------------------------------------------------------------ */
+
+static void test_crc(void)
+{
+    puts("crc16");
+    CHECK(crc16_ccitt((const uint8_t *)"123456789", 9) == 0x29B1);   /* published check value */
+    CHECK(crc16_ccitt((const uint8_t *)"", 0) == 0xFFFF);
+
+    uint8_t buf[64];
+    for (int t = 0; t < 20000; t++) {
+        size_t n = rnd() % sizeof buf;
+        for (size_t i = 0; i < n; i++) buf[i] = (uint8_t)rnd();
+        uint16_t got = crc16_ccitt(buf, n);
+        if (got != crc_tbl(buf, n) || got != ref_crc16_ccitt(buf, n)) { CHECK(0); break; }
+    }
+}
+
+static void test_packet(void)
+{
+    puts("imu_packet");
+    uint8_t raw[14], out[24];
+    for (int i = 0; i < 14; i++) raw[i] = (uint8_t)i;
+
+    imu_packet_encode(out, 0x1234, 0xAABBCCDDu, raw);
+    CHECK(out[0] == 0xAA && out[1] == 0x55);
+    CHECK(out[2] == 0x34 && out[3] == 0x12);                                   /* seq, LE */
+    CHECK(out[4] == 0xDD && out[5] == 0xCC && out[6] == 0xBB && out[7] == 0xAA); /* ts, LE */
+    CHECK(memcmp(&out[8], raw, 14) == 0);                                      /* raw verbatim */
+    uint16_t crc = crc_tbl(&out[2], 20);
+    CHECK(out[22] == (uint8_t)crc && out[23] == (uint8_t)(crc >> 8));          /* crc, LE, over 2..21 */
+
+    /* byte-for-byte equal to the pre-refactor encoder, including seq/ts extremes */
+    static const uint16_t seqs[] = { 0, 1, 0x00FF, 0x0100, 0x7FFF, 0x8000, 0xFFFF };
+    static const uint32_t tss[]  = { 0, 1, 0xFF, 0x100, 0xFFFFu, 0x10000u, 0x7FFFFFFFu, 0x80000000u, 0xFFFFFFFFu };
+    uint8_t exp[24];
+    for (size_t a = 0; a < sizeof seqs / sizeof *seqs; a++)
+        for (size_t b = 0; b < sizeof tss / sizeof *tss; b++) {
+            for (int i = 0; i < 14; i++) raw[i] = (uint8_t)rnd();
+            imu_packet_encode(out, seqs[a], tss[b], raw);
+            ref_encode(exp, seqs[a], tss[b], raw);
+            CHECK(memcmp(out, exp, 24) == 0);
+        }
+    int mismatches = 0;
+    for (int t = 0; t < 200000; t++) {
+        uint16_t s = (uint16_t)rnd();
+        uint32_t ts = rnd();
+        for (int i = 0; i < 14; i++) raw[i] = (uint8_t)rnd();
+        imu_packet_encode(out, s, ts, raw);
+        ref_encode(exp, s, ts, raw);
+        mismatches += memcmp(out, exp, 24) != 0;
+    }
+    CHECK(mismatches == 0);
+}
+
+static void test_queue(void)
+{
+    puts("drdy_queue");
+    drdy_queue_t q;
+    uint32_t v;
+
+    drdy_queue_init(&q);
+    CHECK(!drdy_queue_pop(&q, &v));
+
+    for (uint32_t i = 0; i < DRDY_QUEUE_SIZE - 1u; i++) CHECK(drdy_queue_push_from_isr(&q, 100 + i));
+    CHECK(!drdy_queue_push_from_isr(&q, 999));                 /* capacity is SIZE-1 */
+    CHECK(drdy_queue_dropped(&q) == 1);
+    for (uint32_t i = 0; i < DRDY_QUEUE_SIZE - 1u; i++) { CHECK(drdy_queue_pop(&q, &v)); CHECK(v == 100 + i); }
+    CHECK(!drdy_queue_pop(&q, &v));
+
+    for (uint32_t i = 0; i < 1000; i++) {                      /* wrap-around many times */
+        CHECK(drdy_queue_push_from_isr(&q, i));
+        CHECK(drdy_queue_pop(&q, &v) && v == i);
+    }
+    CHECK(drdy_queue_dropped(&q) == 1);
+
+    /* random push/pop mix must match the pre-refactor ring exactly */
+    drdy_queue_init(&q);
+    ref_head = ref_tail = ref_dropped = 0;
+    int bad = 0;
+    for (int t = 0; t < 2000000; t++) {
+        bool push = (rnd() % 100) < ((t / 50000) % 2 ? 70 : 40);   /* alternate fill/drain phases */
+        if (push) {
+            uint32_t ts = rnd();
+            uint32_t before = ref_dropped;
+            ref_isr(ts);
+            bool ok = drdy_queue_push_from_isr(&q, ts);
+            bad += ok != (ref_dropped == before);
+        } else {
+            uint32_t a = 0, b = 0;
+            bool ra = ref_pop(&a), rb = drdy_queue_pop(&q, &b);
+            bad += (ra != rb) || (ra && a != b);
+        }
+        bad += drdy_queue_dropped(&q) != ref_dropped;
+    }
+    CHECK(bad == 0);
+}
+
+static int count_lines_with(const char *text, const char *prefix)
+{
+    int n = 0;
+    size_t pl = strlen(prefix);
+    for (const char *p = text; *p; ) {
+        if (strncmp(p, prefix, pl) == 0) n++;
+        const char *nl = strchr(p, '\n');
+        if (!nl) break;
+        p = nl + 1;
+    }
+    return n;
+}
+
+static void test_driver(void)
+{
+    puts("mpu6050");
+    static I2C_HandleTypeDef bus;
+    mpu6050_t dev;
+
+    /* Expected sequence is derived by hand from the pre-refactor main.c init code
+     * (reads/writes with 0x68<<1 = 0xD0, timeouts 100, delays 100 and 10). */
+    static const char expected[] =
+        "R dev=0xD0 reg=0x75 len=1 to=100\n"
+        "W dev=0xD0 reg=0x6B val=0x80 to=100\n"
+        "DELAY 100\n"
+        "W dev=0xD0 reg=0x6B val=0x01 to=100\n"
+        "DELAY 10\n"
+        "W dev=0xD0 reg=0x1A val=0x03 to=100\n"
+        "W dev=0xD0 reg=0x19 val=0x09 to=100\n"
+        "W dev=0xD0 reg=0x38 val=0x01 to=100\n";
+
+    mock_reset();
+    CHECK(mpu6050_init(&dev, &bus, MPU6050_ADDR_AD0_LOW) == MPU6050_OK);
+    CHECK(strcmp(mock_trace(), expected) == 0);
+    if (strcmp(mock_trace(), expected) != 0) printf("--- got ---\n%s", mock_trace());
+
+    mock_reset(); mock_cfg.who_am_i = 0x70;                    /* wrong chip */
+    CHECK(mpu6050_init(&dev, &bus, MPU6050_ADDR_AD0_LOW) == MPU6050_ERR_ID);
+    CHECK(count_lines_with(mock_trace(), "W ") == 0);          /* nothing written to a wrong chip */
+
+    mock_reset(); mock_cfg.fail_id_read = 1;                   /* no ACK */
+    CHECK(mpu6050_init(&dev, &bus, MPU6050_ADDR_AD0_LOW) == MPU6050_ERR_BUS);
+    CHECK(count_lines_with(mock_trace(), "W ") == 0);
+
+    for (int k = 1; k <= 5; k++) {                             /* any single failing write stops init */
+        mock_reset(); mock_cfg.fail_write_n = k;
+        CHECK(mpu6050_init(&dev, &bus, MPU6050_ADDR_AD0_LOW) == MPU6050_ERR_BUS);
+        CHECK(count_lines_with(mock_trace(), "W ") == k);
+    }
+
+    uint8_t raw[MPU6050_RAW_LEN];
+    mock_reset();
+    mpu6050_init(&dev, &bus, MPU6050_ADDR_AD0_LOW);
+    CHECK(mpu6050_read_raw(&dev, raw));
+    CHECK(strstr(mock_trace(), "R dev=0xD0 reg=0x3B len=14 to=20\n") != NULL);
+
+    mock_reset(); mock_cfg.fail_burst_from = 1; mock_cfg.fail_burst_to = 1;
+    CHECK(!mpu6050_read_raw(&dev, raw));
+}
+
+int main(void)
+{
+    tbl_init();
+    test_crc();
+    test_packet();
+    test_queue();
+    test_driver();
+    printf("\n%d checks, %d failed\n", g_checks, g_fail);
+    return g_fail ? 1 : 0;
+}
